---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
  priority?: boolean;
}

const supportedWidths = [340, 360, 400] as const;

const nearestSupportedWidth = (target: number) =>
  supportedWidths.reduce((nearest, candidate) =>
    Math.abs(candidate - target) < Math.abs(nearest - target) ? candidate : nearest,
  );

const { src, alt, caption, width = 360, priority = false } = Astro.props;
const displayWidth = nearestSupportedWidth(Math.min(width, Math.round(src.width / 2)));
const widths = [displayWidth, displayWidth * 2].filter((candidate) => candidate <= src.width);
const sizes = `(max-width: ${displayWidth + 32}px) calc(100vw - 32px), ${displayWidth}px`;
const hasRichCaption = Astro.slots.has("default");
const hasCaption = hasRichCaption || Boolean(caption);
---

<figure class:list={["shot", `shot-${displayWidth}`]}>
  <div class="shot-frame">
    <Image
      src={src}
      alt={alt}
      width={displayWidth}
      widths={widths}
      sizes={sizes}
      quality={90}
      priority={priority}
    />
  </div>
  {hasCaption && <figcaption class="shot-caption">{hasRichCaption ? <slot /> : caption}</figcaption>}
</figure>

<style>
  .shot {
    width: 100%;
  }

  .shot-340 {
    max-width: 340px;
  }

  .shot-360 {
    max-width: 360px;
  }

  .shot-400 {
    max-width: 400px;
  }

  .shot-frame {
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: 16px;
    background: var(--color-frame-bg);
    box-shadow: var(--shadow-frame);
  }

  .shot-frame :global(img) {
    width: 100%;
    height: auto;
  }

  .shot-caption {
    margin-top: 16px;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .shot-caption :global(strong) {
    color: var(--color-ink);
    font-weight: 650;
  }
</style>
