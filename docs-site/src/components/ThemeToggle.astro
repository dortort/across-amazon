<button class="theme-toggle" type="button" aria-pressed="false" data-theme-toggle>
  <span class="visually-hidden">Dark theme</span>
  <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
  <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
  </svg>
</button>

<script>
  type Theme = "light" | "dark";

  const storageKey = "theme";
  const root = document.documentElement;
  const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

  const systemTheme = (): Theme => (darkQuery.matches ? "dark" : "light");

  const activeTheme = (): Theme => {
    const chosen = root.dataset.theme;
    return chosen === "light" || chosen === "dark" ? chosen : systemTheme();
  };

  const syncToggles = () => {
    const isDark = activeTheme() === "dark";
    for (const toggle of document.querySelectorAll("[data-theme-toggle]")) {
      toggle.setAttribute("aria-pressed", String(isDark));
    }
  };

  const syncThemeColor = () => {
    const background = getComputedStyle(root).getPropertyValue("--color-bg").trim();
    for (const themeColor of document.querySelectorAll('meta[name="theme-color"]')) {
      themeColor.setAttribute("content", background);
    }
  };

  const syncTheme = () => {
    syncToggles();
    syncThemeColor();
  };

  const rememberTheme = (theme: Theme | null) => {
    try {
      if (theme === null) localStorage.removeItem(storageKey);
      else localStorage.setItem(storageKey, theme);
    } catch {}
  };

  const applyTheme = (theme: Theme) => {
    if (theme === systemTheme()) {
      delete root.dataset.theme;
      rememberTheme(null);
    } else {
      root.dataset.theme = theme;
      rememberTheme(theme);
    }
    syncTheme();
  };

  for (const toggle of document.querySelectorAll("[data-theme-toggle]")) {
    toggle.addEventListener("click", () => applyTheme(activeTheme() === "dark" ? "light" : "dark"));
  }

  darkQuery.addEventListener("change", syncTheme);
  syncTheme();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-rule-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-ink);
  }

  .theme-icon {
    grid-area: 1 / 1;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-icon-sun {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-icon-sun {
    display: block;
  }

  :global(:root[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-icon-sun {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .theme-icon-moon {
      display: none;
    }
  }
</style>
