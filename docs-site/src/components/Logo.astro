---
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<img
  class="logo-tile"
  src="/icons/icon-128.png"
  width={size}
  height={size}
  alt=""
  decoding="async"
/>

<style>
  .logo-tile {
    flex: none;
    border-radius: 22%;
    box-shadow: var(--ring-on-dark);
  }
</style>
