{
  "name": "across-amazon",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Across Amazon Chrome extension",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build && (vite build --watch --no-emptyOutDir & vite build --config vite.offscreen.config.ts --watch & wait)",
    "build": "vite build && vite build --config vite.offscreen.config.ts && cp manifest.json dist/manifest.json",
    "package": "scripts/package-extension.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:linux-snapshots": "scripts/update-linux-snapshots.sh",
    "docs:screenshots": "node scripts/capture-screenshots.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
