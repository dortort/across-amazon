{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["chrome", "node", "vitest/globals"]
  },
  "include": ["src", "tests", "scripts", "vite.config.ts", "vite.offscreen.config.ts", "eslint.config.js", "playwright.config.ts"]
}
